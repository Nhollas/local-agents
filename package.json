{
	"name": "local-agents",
	"version": "1.0.0",
	"description": "Local autonomous agents powered by Claude Agent SDK",
	"type": "module",
	"packageManager": "pnpm@9.15.2",
	"scripts": {
		"prepare": "husky && effect-tsgo patch",
		"start": "node server/server.ts",
		"dev": "concurrently -k -n orchestrator,dashboard -c blue,magenta \"node --watch server/server.ts\" \"vite --config dashboard/vite.config.ts\"",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:dashboard": "vitest run --project dashboard",
		"typecheck": "tsgo --noEmit && tsgo --noEmit -p dashboard/tsconfig.json",
		"knip": "knip",
		"db:generate": "drizzle-kit generate",
		"langfuse:up": "docker compose -f infra/langfuse/docker-compose.yml --env-file infra/langfuse/.env up -d",
		"langfuse:down": "docker compose -f infra/langfuse/docker-compose.yml down",
		"langfuse:logs": "docker compose -f infra/langfuse/docker-compose.yml logs -f langfuse-web langfuse-worker"
	},
	"lint-staged": {
		"*.{ts,tsx,json,mjs}": "biome check --write --no-errors-on-unmatched"
	},
	"keywords": [],
	"author": "Nick Hollas",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "https://github.com/Nhollas/local-agents.git"
	},
	"engines": {
		"node": ">=22.6.0"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.142",
		"@arizeai/openinference-instrumentation-claude-agent-sdk": "^0.2.4",
		"@effect/platform": "^0.96.1",
		"@effect/platform-node": "^0.106.0",
		"@hono/node-server": "^2.0.1",
		"@hono/zod-validator": "^0.8.0",
		"@langfuse/otel": "^5.3.0",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/exporter-logs-otlp-http": "0.218.0",
		"@opentelemetry/exporter-metrics-otlp-http": "0.218.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.218.0",
		"@opentelemetry/resources": "2.7.1",
		"@opentelemetry/sdk-node": "0.218.0",
		"@opentelemetry/semantic-conventions": "1.41.1",
		"@tanstack/react-query": "^5.100.10",
		"better-sqlite3": "^12.10.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"effect": "^3.21.2",
		"hono": "^4.12.18",
		"pino": "^10.3.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@effect/tsgo": "0.7.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.5.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "latest",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/browser-playwright": "^4.1.3",
		"@vitest/coverage-v8": "^4.1.3",
		"concurrently": "^9.2.1",
		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"knip": "^6.3.0",
		"lint-staged": "^17.0.2",
		"msw": "^2.13.1",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.59.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-react": "^2.2.0"
	}
}
