# Path to central config (required)
CONFIG_PATH=./config.yaml

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Dashboard API port (default: 3000)
# PORT=3000

# Code-host token. Set the one that matches `code_host.kind` in config.yaml.
#
# GitHub: needs `repo` scope to read repo contents and open pull requests.
# GitLab: needs API access to read repo files and open merge requests.
GITHUB_TOKEN=
GITLAB_TOKEN=

# Jira Cloud credentials (required)
JIRA_EMAIL=
JIRA_API_TOKEN=

# Langfuse credentials (required). Get the keys and project ID from
# http://localhost:3100 → Project → Settings → API keys after
# `pnpm langfuse:up` and signing in.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
# LANGFUSE_HOST=http://localhost:3100
